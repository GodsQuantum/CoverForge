    "youtube": {
      "canvas": {
        "width": 1920,
        "height": 1080,
        "background": "#111827"
      },
      "layers": [
        {
          "type": "image",
          "id": "background",
          "name": "Image source",
          "frame": {
            "x": 0,
            "y": 0,
            "width": 1,
            "height": 1
          },
          "source": "{{background}}",
          "fit": "cover",
          "focal_x": 0.5,
          "focal_y": 0.5,
          "opacity": 1
        },
        {
          "type": "rect",
          "id": "shade",
