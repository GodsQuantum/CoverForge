{
  "version": 1,
  "id": "example-social",
  "canvas": { "width": 1280, "height": 720, "background": "#101817" },
  "variants": {
    "youtube": { "width": 1280, "height": 720, "background": "#101817" },
    "square": { "width": 1080, "height": 1080, "background": "#101817" },
    "portrait": { "width": 1080, "height": 1920, "background": "#101817" }
  },
  "layers": [
    {
      "type": "image",
      "id": "background",
      "frame": { "x": 0.0, "y": 0.0, "width": 1.0, "height": 1.0 },
      "source": "{{background}}",
      "fit": "cover",
      "focal_x": 0.5,
      "focal_y": 0.5,
      "opacity": 1.0
    },
    {
      "type": "rect",
      "id": "title_backdrop",
      "frame": { "x": 0.04, "y": 0.58, "width": 0.76, "height": 0.34 },
      "fill": "#09100f",
      "opacity": 0.88,
      "radius": 0.018
    },
    {
      "type": "text",
      "id": "title",
      "frame": { "x": 0.07, "y": 0.61, "width": 0.68, "height": 0.27 },
      "text": "{{title}}",
      "font_family": "League Spartan",
      "font_weight": 700,
      "font_size": 0.092,
      "color": "#ffffff",
      "align": "left",
      "max_lines": 3,
      "line_height": 0.88,
      "uppercase": true
    },
    {
      "type": "image",
      "id": "logo",
      "frame": { "x": 0.78, "y": 0.05, "width": 0.17, "height": 0.17 },
      "source": "{{logo}}",
      "fit": "contain",
      "focal_x": 0.5,
      "focal_y": 0.5,
      "opacity": 1.0
    }
  ]
}
