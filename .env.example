COVERFORGE_BIND=127.0.0.1:3099
COVERFORGE_TEMPLATE_DIR=./templates
COVERFORGE_OUTPUT_DIR=./output
COVERFORGE_ASSET_ROOTS=./examples/assets
COVERFORGE_FONT_DIR=/usr/share/fonts/truetype/league-spartan
RUST_LOG=coverforge=info,tower_http=info

# Optional container port and relative host media directories
COVERFORGE_BIND_HOST=127.0.0.1
COVERFORGE_PORT=3099
COVERFORGE_ASSETS_HOST_DIR=./data/assets
COVERFORGE_OUTPUT_HOST_DIR=./data/output
COVERFORGE_TEMPLATES_HOST_DIR=./data/templates
COVERFORGE_FONTS_HOST_DIR=./data/fonts
